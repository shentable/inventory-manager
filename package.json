{
  "name": "sandwich-inventory-pilot",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "cf:types": "wrangler types --config cloudflare/wrangler.jsonc cloudflare/worker-configuration.d.ts",
    "cf:dev": "wrangler dev --config cloudflare/wrangler.jsonc",
    "cf:migrate:local": "wrangler d1 migrations apply sandwich-inventory --local --config cloudflare/wrangler.jsonc",
    "cf:test": "vitest run --config cloudflare/vitest.config.mts",
    "cf:check": "npm run cf:types && tsc -p cloudflare/tsconfig.json --noEmit && wrangler deploy --dry-run --config cloudflare/wrangler.jsonc",
    "test:e2e": "playwright test",
    "test:e2e:native": "playwright test --config playwright.native.config.js",
    "test:e2e:vps": "playwright test --config playwright.vps.config.js",
    "build:linux-native": "./scripts/build-linux-native.sh"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.3",
    "@cloudflare/workers-types": "^5.20260902.1",
    "@playwright/test": "1.62.1",
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.128.0"
  }
}
